+							function computeOverlaps()
+							{
+								var model = graph.getModel();
+								var boxes = [];
+								var all = model.cells;
+
+								for (var cellId in all)
+								{
+									var c = all[cellId];
+									if (c == model.getRoot() || c.getParent() == null) continue;
+									var state = graph.view.getState(c);
+									if (state == null) continue;
+
+									if (state.shape != null && state.shape.boundingBox != null)
+									{
+										boxes.push({id: c.id, part: 'shape', bounds: state.shape.boundingBox});
+									}
+									if (state.text != null && state.text.boundingBox != null)
+									{
+										boxes.push({id: c.id, part: 'label', bounds: state.text.boundingBox});
+									}
+								}
+
+								var overlaps = [];
+								for (var i = 0; i < boxes.length; i++)
+								{
+									for (var j = i + 1; j < boxes.length; j++)
+									{
+										if (boxes[i].id == boxes[j].id) continue;
+										var cellA = model.getCell(boxes[i].id);
+										var cellB = model.getCell(boxes[j].id);
+										if (model.isAncestor(cellA, cellB) || model.isAncestor(cellB, cellA)) continue;
+										if (boxesIntersect(boxes[i].bounds, boxes[j].bounds))
+										{
